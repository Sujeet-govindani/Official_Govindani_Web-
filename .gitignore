# dependencies
node_modules/

# build output
dist/
build/

# env files
.env
.env.*

# logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# media/temp
public/Videos/

# python
*.py

# archives
*.zip

# macOS
.DS_Store
**/.DS_Store

# build/report artifacts
prerender-report.json

# local editor/tooling config (contains machine-specific absolute paths)
.claude/

# scratch + recovery working folders (kept outside the repo, on the Desktop)
r2-*/
old-bucket-rescue/
recovered-videos/
video-work/
video-fixed/
portfolio-480/
platform-logos/
git-recovered/
card-recovered/
bg-generated/
hero-encodes/
compressed-test/
dist-working-backup/
slide-fix/
ve-bg/
INSTITUTE/

# working backups created during edits
*.bak
*.bak.*

# i18n intermediates: strings.json is regenerated from dist by extract.py, and
# run.log is just progress output. hi.json IS committed — it is the translation.
tools/i18n/strings.json
tools/i18n/run.log
tools/blog/out/
tools/blog/w*.log
tools/blog/write.log
tools/i18n/run*.log
tools/i18n/source_missing.json
tools/i18n/untranslated.json
tools/seo/audit.json
tools/seo/fix_targets.json

# The blanket *.py rule above silently excluded the build's own tooling: the
# deploy failed because prune_scheduled.py was never committed. The scripts the
# build shells out to must be tracked; their large outputs stay ignored below.
!tools/**/*.py

# Local-run artifacts: written continuously while a probe run is in flight, so
# they must never block a rebase. The scored corpora that matter are committed
# deliberately, not as a side effect of a run.
tools/bot/results-local-*.json
tools/bot/local*.log

# BackstopJS — keep the reference baseline, ignore generated test output
backstop_data/bitmaps_test/
backstop_data/html_report/
backstop_data/ci_report/
